# Public, browser-safe Supabase configuration only.
# Copy this file to .env.local and fill in values from Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Required public UUID of the portfolio owner (Supabase auth.users.id)
# Without it, the CMS and database-backed contact form will not operate.
VITE_PORTFOLIO_OWNER_ID=

# NEVER put a service_role or secret key in a VITE_ variable.
# Vite embeds all VITE_* values in the publicly served JavaScript bundle.
# Service-role operations require a separately secured server environment.
